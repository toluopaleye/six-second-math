rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each person can read and write only their own progress document: users/{their uid}.
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['json', 'updatedAt', 'v'])
        && request.resource.data.json is string
        && request.resource.data.json.size() < 400000;
    }
  }
}
